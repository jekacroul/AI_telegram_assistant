# Telegram API credentials (https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_NAME=telegram_local_ai

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=mistral:7b

# Database
DATABASE_URL=sqlite+aiosqlite:///./telegram_local_ai.db

# Server
API_HOST=127.0.0.1
API_PORT=8000

# Training
HF_BASE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
TRAINING_OUTPUT_DIR=./models
TRAINING_DATA_DIR=./training_data
MIN_PAIRS_FOR_TRAINING=50
USE_4BIT=true
