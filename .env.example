TELEGRAM_BOT_TOKEN=
# OpenAI-compatible local server (LM Studio / llama.cpp / vLLM).
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=local
OPENAI_MODEL=local-model
LLM_MAX_TOKENS=2048
AUTO_REPLY=false
DB_PATH=./data/database.db
TRAINING_DATA_PATH=./training_data/
MODELS_PATH=./models/
LOGS_PATH=./logs/
WEBHOOK_BASE_URL=
USER_NAME=Я
HF_BASE_MODEL=mistralai/Mistral-7B-Instruct-v0.2
# Telegram chat_id to receive notifications when the bot auto-replies.
# Leave empty to disable notifications. Use the "Detect automatically"
# button in Settings → Notifications after writing /start to the bot in private.
NOTIFY_CHAT_ID=
# Авто-запуск llama-server.exe с базовой моделью + активным LoRA.
# Бэкенд сам поднимет HTTP-сервер на 127.0.0.1:<port>/v1 — туда ходит
# OPENAI_BASE_URL. LM Studio тогда не нужна.
# LLAMA_BASE_MODEL_GGUF — путь к базовой .gguf (Q4_K_S / Q5_K_M / ...).
# LLAMA_SERVER_BIN — необязательно, прямой путь к llama-server.exe.
#   Если не задан, ищется внутри LLAMA_CPP_PATH.
# LLAMA_SERVER_NGL — слоёв на GPU (99 = все доступные).
# LLAMA_SERVER_CTX — размер контекста.
# LLAMA_SERVER_AUTO_START — поднимать ли при старте бэкенда.
LLAMA_BASE_MODEL_GGUF=
LLAMA_SERVER_BIN=
LLAMA_SERVER_PORT=1234
LLAMA_SERVER_NGL=99
LLAMA_SERVER_CTX=4096
LLAMA_SERVER_AUTO_START=true
